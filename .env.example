# Copy this file to .env or inject these values through your MCP client configuration.
# Never commit real API keys.
KCSC_API_KEY=your_kcsc_api_key
LAW_API_KEY=your_law_openapi_oc_key

# Optional: root folder containing engineering reference documents (.md/.markdown/.txt/.pdf).
# Subfolders and filenames may be organized by field, e.g. 도로/, 철도/, 건축/, 상수도/.
REFERENCE_DIR=/absolute/path/to/engineering/references

# Optional local-reference indexing limits (safe defaults shown).
REFERENCE_MAX_FILES=50
REFERENCE_MAX_FILE_BYTES=5242880
REFERENCE_MAX_DEPTH=3

# Optional: standard estimation (표준품셈) auto-cache. No key needed; search_standard_estimation
# fetches the latest edition from CODIL(codil.or.kr) on its own.
# Default cache dir: ~/.korean-engineering-mcp/standard-estimation
STANDARD_ESTIMATION_CACHE_DIR=/absolute/path/to/standard-estimation-cache
STANDARD_ESTIMATION_CHECK_TTL_MS=86400000

# Optional: generated HTML report directory and display timezone.
# Default output: ~/.korean-engineering-mcp/outputs
ENGINEERING_OUTPUT_DIR=/absolute/path/to/engineering/outputs
ENGINEERING_TIMEZONE=Asia/Seoul

# Optional external API timeout in milliseconds.
FETCH_TIMEOUT_MS=15000
